---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Mission from '../components/sections/Mission.astro';
import WhatIsReiki from '../components/sections/WhatIsReiki.astro';
import Pricing from '../components/sections/Pricing.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { t } from '../i18n/index';
import { getCollection } from 'astro:content';

const lang = 'de' as const;
const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Home">
  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Meine Mission -->
  <Mission />

  <!-- 3. Was ist Reiki -->
  <WhatIsReiki />

  <!-- 4. Sessions und Preise -->
  <Pricing />

  <!-- 5. Sound & Soul -->
  <section id="sound-and-soul" class="py-20 px-4">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-gold text-sm tracking-[0.3em] uppercase mb-6">{t(lang, 'soundAndSoul.comingSoon')}</p>
      <h2 class="font-heading text-4xl md:text-5xl text-dark-brown italic leading-tight mb-6">{t(lang, 'soundAndSoul.title')}</h2>
      <p class="text-warm-brown text-lg leading-relaxed mb-4">{t(lang, 'soundAndSoul.subtitle')}</p>
      <p class="text-warm-brown/70 leading-relaxed mb-10">{t(lang, 'soundAndSoul.comingText')}</p>
      <Button href="/kontakt">{t(lang, 'soundAndSoul.contactBtn')}</Button>
    </div>
  </section>

  <!-- 6. Testimonials -->
  <section id="testimonials" class="py-20 px-4 bg-cream-light/50">
    <div class="mx-auto max-w-4xl">
      <SectionHeading title={t(lang, 'testimonials.title')} subtitle={t(lang, 'testimonials.subtitle')} />
      <div class="space-y-8">
        {testimonials.map((item) => (
          <div class="bg-soft-white/60 backdrop-blur-sm p-8 rounded-sm text-center">
            <p class="text-warm-brown leading-relaxed italic text-lg mb-4">&ldquo;{item.data.text_de}&rdquo;</p>
            <p class="text-gold text-sm tracking-wider uppercase">{item.data.name_de}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Über mich -->
  <section id="ueber-mich" class="py-20 px-4">
    <div class="mx-auto max-w-5xl">
      <SectionHeading title="Über mich" />
    </div>
    <div class="mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="aspect-[3/4] bg-cream-dark rounded-sm overflow-hidden max-w-md mx-auto">
        <img src="/images/kiki-ocean.jpg" alt="Kiki — Sun & Soul Reiki" class="w-full h-full object-cover object-top" loading="lazy" />
      </div>
      <div>
        <h3 class="font-heading text-2xl md:text-3xl text-dark-brown italic leading-tight mb-6">{t(lang, 'about.greeting')}</h3>
        <p class="text-warm-brown leading-relaxed mb-4">{t(lang, 'about.intro1')}</p>
        <p class="text-warm-brown leading-relaxed mb-8">{t(lang, 'about.intro2')}</p>
        <Button href="/ueber-mich">Mehr erfahren</Button>
      </div>
    </div>
  </section>
</BaseLayout>
