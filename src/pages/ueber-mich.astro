---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { t, tList } from '../i18n/index';

const lang = 'de' as const;
---

<BaseLayout title="Über mich" description="Lerne Kiki kennen — Zertifizierte Reiki-Praktizierende in Berlin.">

  <section class="py-20 px-4">
    <div class="mx-auto max-w-5xl">
      <SectionHeading title="Über mich" />
    </div>
    <div class="mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="aspect-[3/4] bg-cream-dark rounded-sm overflow-hidden max-w-md mx-auto">
        <img src="/images/kiki-ocean.jpg" alt="Kiki — Sun & Soul Reiki" class="w-full h-full object-cover object-top" loading="eager" />
      </div>
      <div>
        <h3 class="font-heading text-2xl md:text-3xl text-dark-brown italic leading-tight mb-6">{t(lang, 'about.greeting')}</h3>
        <p class="text-warm-brown leading-relaxed mb-4">{t(lang, 'about.intro1')}</p>
        <p class="text-warm-brown leading-relaxed">{t(lang, 'about.intro2')}</p>
      </div>
    </div>
  </section>

  <section class="py-20 px-4 bg-cream-light/50">
    <div class="mx-auto max-w-3xl">
      <SectionHeading title="Ein paar Dinge über mich" />
      <div class="space-y-10">

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Heimat:</h3>
          <p class="text-warm-brown leading-relaxed">Ich bin in einer Kleinstadt in Brandenburg aufgewachsen und lebe seit 7 Jahren in Berlin.</p>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Studium und Forschung:</h3>
          <p class="text-warm-brown leading-relaxed">Eigentlich habe ich Gartenbauwissenschaften studiert und dabei unter anderem Viren in Birken untersucht. Mich hat schon immer interessiert, was um uns herum passiert und wie Dinge grundlegend funktionieren.</p>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Ich bin:</h3>
          <p class="text-warm-brown leading-loose">ein Frühlingsmensch - Langschläferin - Naturliebhaberin - Yogamaus - Foodie - Quasselstrippe</p>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Bewegung und Abenteuer:</h3>
          <p class="text-warm-brown leading-loose">Tanzen - Windsurfen - Reiten - Ballett - Japanische Stockkampfkunst - Messerwerfen - Step Aerobic - Rudern - Yoga - Pilates - Jetski fahren</p>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Ruhe und Ausgleich:</h3>
          <ul class="space-y-2 text-warm-brown leading-relaxed list-disc list-inside">
            <li>zum Schweigen ins Kloster gehen</li>
            <li>3–4 Tage komplett in Ruhe draußen auf einer Wiese zu liegen und nichts zu tun</li>
          </ul>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Orakel auf Abruf:</h3>
          <ul class="space-y-2 text-warm-brown leading-relaxed list-disc list-inside">
            <li>meine Träume sagen mir manchmal die Zukunft voraus</li>
          </ul>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Herausforderungen:</h3>
          <ul class="space-y-2 text-warm-brown leading-relaxed list-disc list-inside">
            <li>nervige Geräusche (ich bin leicht neurodivergent)</li>
            <li>zu wenig Schlaf</li>
            <li>zu viele Menschen an einem Ort</li>
          </ul>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Mein Sternzeichen:</h3>
          <p class="text-warm-brown leading-relaxed">Sonne im Widder - Aszendent Skorpion - Mond im Löwe</p>
        </div>

        <div>
          <h3 class="font-heading text-xl text-dark-brown font-semibold mb-3">Meine Lieblingsbücher:</h3>
          <ul class="space-y-2 text-warm-brown leading-relaxed list-disc list-inside">
            <li>Ask Your Guides – Sonia Choquette</li>
            <li>Three Waves of Volunteers & The New Earth – Dolores Cannon</li>
            <li>The Alchemist – Paulo Coelho</li>
            <li>The Woman Code – Alisa Vitti</li>
            <li>Untamed – Glennon Doyle</li>
            <li>How to Think Like a Monk – Jay Shetty</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 px-4 bg-cream-light/50">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeading title={t(lang, 'about.valuesTitle')} />
      <div class="space-y-6 text-warm-brown leading-relaxed">
        <p>{t(lang, 'about.values1')}</p>
        <p>{t(lang, 'about.values2')}</p>
        <p>{t(lang, 'about.values3')}</p>
      </div>
    </div>
  </section>

  <section class="py-20 px-4 text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-heading text-3xl md:text-4xl text-dark-brown italic mb-6">{t(lang, 'cta.title')}</h2>
      <p class="text-warm-brown leading-relaxed mb-8">{t(lang, 'cta.text')}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/buchen" variant="primary">{t(lang, 'cta.bookBtn')}</Button>
        <Button href="/kontakt">{t(lang, 'cta.contactBtn')}</Button>
      </div>
    </div>
  </section>

</BaseLayout>
