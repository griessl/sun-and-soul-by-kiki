---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Sound & Soul" description="Sound & Soul — Kombination aus Reiki und Frequenztherapie. Coming Soon.">
  <section class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="text-center max-w-2xl">
      <p class="text-gold text-sm tracking-[0.3em] uppercase mb-6">Coming Soon</p>
      <h1 class="font-heading text-4xl md:text-5xl text-dark-brown italic leading-tight mb-6">Sound & Soul</h1>
      <p class="text-warm-brown text-lg leading-relaxed mb-4">Eine Kombination aus Reiki und Frequenzen.</p>
      <p class="text-warm-brown/70 leading-relaxed mb-10">
        Dieses Angebot wird gerade vorbereitet. Schreib mir gerne, wenn du mehr erfahren möchtest.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/kontakt" variant="primary">Nachricht schreiben</Button>
        <Button href="/">Zurück zur Startseite</Button>
      </div>
    </div>
  </section>
</BaseLayout>
