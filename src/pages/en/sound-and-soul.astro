---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout title="Sound & Soul" lang="en" description="Sound & Soul — a combination of Reiki and Sound. Coming Soon.">
  <section class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="text-center max-w-2xl">
      <p class="text-gold text-sm tracking-[0.3em] uppercase mb-6">Coming Soon</p>
      <h1 class="font-heading text-4xl md:text-5xl text-dark-brown italic leading-tight mb-6">Sound & Soul</h1>
      <p class="text-warm-brown text-lg leading-relaxed mb-4">A combination of Reiki and Sound.</p>
      <p class="text-warm-brown/70 leading-relaxed mb-10">
        This offering is currently being prepared. Feel free to reach out if you'd like to know more.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/en/contact" variant="primary">Send a message</Button>
        <Button href="/en">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
