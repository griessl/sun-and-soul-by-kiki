---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { t } from '../../i18n/index';

const lang = 'en' as const;
---

<BaseLayout title="Book a Session" lang="en" description="Book your Reiki session with Kiki — in Berlin or as a remote session.">
  <section class="py-20 px-4">
    <div class="mx-auto max-w-4xl text-center">
      <SectionHeading title={t(lang, 'booking.title')} subtitle={t(lang, 'booking.subtitle')} />
      <div class="bg-soft-white/60 backdrop-blur-sm p-12 rounded-sm">
        <p class="text-warm-brown mb-6">{t(lang, 'booking.placeholder')}</p>
        <p class="text-warm-brown/60 text-sm">{t(lang, 'booking.fallback')}</p>
        <a
          href="mailto:hello@sunandsoulbykiki.de"
          class="inline-block mt-4 border border-gold text-gold hover:bg-gold hover:text-soft-white transition-colors px-8 py-3 text-sm tracking-wider uppercase"
        >
          {t(lang, 'booking.emailBtn')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
