---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { t } from '../i18n/index';
import siteSettings from '../content/settings/site.json';

const lang = 'de' as const;
---

<BaseLayout title="Termin buchen" description="Buche deine Reiki-Session mit Kiki in Berlin oder als Remote-Session.">
  <section class="py-8 md:py-14 lg:py-20 px-4">
    <div class="mx-auto max-w-4xl text-center">
      <SectionHeading title={t(lang, 'booking.title')} subtitle={t(lang, 'booking.subtitle')} as="h1" />
      <div class="bg-soft-white/60 backdrop-blur-sm p-12 rounded-sm">
        <p class="text-warm-brown mb-6">{t(lang, 'booking.placeholder')}</p>
        <p class="text-warm-brown/60 text-sm mb-6">{t(lang, 'booking.fallback')}</p>
        <Button href={`mailto:${siteSettings.email}`} variant="primary">{t(lang, 'booking.emailBtn')}</Button>
      </div>
      <p class="mt-8 text-warm-brown/60 text-sm">
        Oder hast du noch Fragen?
        <a href="/kontakt" class="text-gold hover:text-dark-brown underline underline-offset-2 transition-colors">Schreib mir eine Nachricht</a>
      </p>
    </div>
  </section>
</BaseLayout>
