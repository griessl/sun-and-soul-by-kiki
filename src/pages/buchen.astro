---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CalEmbed from '../components/ui/CalEmbed.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { t } from '../i18n/index';

const lang = 'de' as const;
---

<BaseLayout title="Termin buchen" description="Buche deine Reiki-Session mit Kiki in Berlin oder als Fern-Reiki online.">
  <section class="py-20 px-4">
    <div class="mx-auto max-w-5xl">
      <SectionHeading title={t(lang, 'booking.title')} subtitle={t(lang, 'booking.subtitle')} />

      <div class="mt-12 space-y-16">
        <!-- Fern-Reiki -->
        <div>
          <div class="text-center mb-6 max-w-2xl mx-auto">
            <h3 class="font-heading text-2xl md:text-3xl italic text-dark-brown mb-3">Fern-Reiki Session</h3>
            <p class="text-warm-brown leading-relaxed">
              60 Minuten · Online via Video · 85&nbsp;€<br />
              <span class="text-warm-brown/70 text-sm">45 min. Reiki-Behandlung &amp; 15 min. Beratung</span>
            </p>
          </div>
          <CalEmbed calLink="by-kiki/fern-reiki" namespace="fern-reiki" />
        </div>

        <!-- Berlin Schöneberg -->
        <div>
          <div class="text-center mb-6 max-w-2xl mx-auto">
            <h3 class="font-heading text-2xl md:text-3xl italic text-dark-brown mb-3">Reiki Session in Berlin, Schöneberg</h3>
            <p class="text-warm-brown leading-relaxed">
              90 Minuten · Vor Ort in Berlin Schöneberg · 100&nbsp;€<br />
              <span class="text-warm-brown/70 text-sm">15 min. Vorgespräch · 60 min. Behandlung · 15 min. Nachgespräch</span>
            </p>
            <p class="text-warm-brown/80 italic text-xs md:text-sm mt-4">Hinweis: Vor-Ort-Termine sind zunächst eine Anfrage. Kiki bestätigt deinen Wunschtermin per E-Mail. Die genaue Adresse erhältst du in der Bestätigung.</p>
          </div>
          <CalEmbed calLink="by-kiki/reiki-berlin" namespace="reiki-berlin" />
        </div>
      </div>

      <!-- Direkt-Kontakt-Formular -->
      <div class="mt-20 max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <h3 class="font-heading text-2xl md:text-3xl italic text-dark-brown mb-3">Du hast eine Frage?</h3>
          <p class="text-warm-brown/80 text-sm md:text-base">Dann kontaktiere mich direkt:</p>
        </div>
        <ContactForm lang={lang} subject="Anfrage über Buchungs-Seite — Sun & Soul" />
      </div>
    </div>
  </section>
</BaseLayout>
