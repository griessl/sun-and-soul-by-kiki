---
import '../styles/global.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import { getLocalizedPath, type Lang } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description = 'Sun & Soul by Kiki – Reiki Sessions in Berlin und Online.',
  lang = 'de',
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalBase = 'https://sunandsoulbykiki.de';
const canonicalUrl = `${canonicalBase}${currentPath}`;
const alternateLang = lang === 'de' ? 'en' : 'de';
const alternatePath = getLocalizedPath(currentPath, alternateLang);
const fullTitle = `${title} | Sun & Soul by Kiki`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "@id": `${canonicalBase}/#business`,
  "name": "Sun & Soul by Kiki",
  "description": lang === 'de'
    ? "Reiki Sessions in Berlin und Online. Zertifizierte Reiki-Praktizierende (Usui Reiki Ryoho)."
    : "Reiki Sessions in Berlin and Online. Certified Reiki Practitioner (Usui Reiki Ryoho).",
  "url": canonicalBase,
  "image": `${canonicalBase}/images/kiki-hero.jpg`,
  "email": "by-kiki@gmx.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hohenstaufenstraße 42",
    "addressLocality": "Berlin",
    "addressRegion": "Berlin",
    "postalCode": "10781",
    "addressCountry": "DE"
  },
  "founder": {
    "@type": "Person",
    "name": "Frederike Helders",
    "alternateName": "Kiki"
  },
  "areaServed": [
    { "@type": "City", "name": "Berlin" },
    { "@type": "Country", "name": "Germany" }
  ],
  "serviceType": ["Reiki", "Fern-Reiki", "Sound & Soul"],
  "availableLanguage": ["German", "English"],
  "priceRange": "€€",
  "sameAs": [
    "https://www.instagram.com/sunandsoul_bykiki/"
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={`${canonicalBase}${lang === 'de' ? currentPath : alternatePath}`} />
    <link rel="alternate" hreflang="en" href={`${canonicalBase}${lang === 'en' ? currentPath : alternatePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${canonicalBase}${lang === 'de' ? currentPath : alternatePath}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${canonicalBase}/images/kiki-hero.jpg`} />
    <meta property="og:image:width" content="1086" />
    <meta property="og:image:height" content="724" />
    <meta property="og:image:alt" content="Sun & Soul by Kiki — Reiki Sessions in Berlin und Online" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:site_name" content="Sun & Soul by Kiki" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonicalBase}/images/kiki-hero.jpg`} />
    <meta name="twitter:image:alt" content="Sun & Soul by Kiki — Reiki Sessions in Berlin und Online" />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="min-h-screen bg-cream">
    <Navigation lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
