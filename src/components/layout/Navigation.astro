---
import { t, getNavItems, getBookingPath, getLocalizedPath, type Lang } from '../../i18n/index';
import Button from '../ui/Button.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const navItems = getNavItems(lang);
const bookingPath = getBookingPath(lang);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const switchPath = getLocalizedPath(Astro.url.pathname, otherLang);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Determine which nav item is active based on current page path
function isNavActive(item: typeof navItems[0]): boolean {
  const itemHref = item.href.replace(/\/$/, '') || '/';
  if (currentPath === itemHref) return true;
  // Check children paths
  if (item.children) {
    return item.children.some(child => currentPath === (child.href.replace(/\/$/, '') || '/'));
  }
  return false;
}
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/90 backdrop-blur-sm">
  <nav class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
    <a href={lang === 'en' ? '/en' : '/'} class="font-heading text-dark-brown text-lg leading-tight">
      <span class="block text-xl font-semibold italic">Sun & Soul</span>
      <span class="block text-sm tracking-wider">by Kiki</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navItems.map((item) => {
        const active = isNavActive(item);
        return item.children ? (
          <li class="relative group">
            <a
              href={item.href}
              data-scroll-href={item.scrollHref}
              class:list={[
                'nav-link text-sm tracking-wide uppercase transition-colors cursor-pointer',
                active ? 'text-dark-brown font-semibold' : 'text-warm-brown hover:text-dark-brown',
              ]}
              data-nav-item
              data-section={item.sectionId}
            >
              {item.label}
            </a>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <ul class="bg-cream/95 backdrop-blur-sm border border-cream-dark rounded-sm shadow-lg py-2 min-w-[160px]">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-5 py-2 text-sm text-warm-brown hover:text-dark-brown hover:bg-cream-light/60 transition-colors"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              data-scroll-href={item.scrollHref}
              class:list={[
                'nav-link text-sm tracking-wide uppercase transition-colors',
                active ? 'text-dark-brown font-semibold' : 'text-warm-brown hover:text-dark-brown',
              ]}
              data-nav-item
              data-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
        );
      })}
      <li>
        <Button href={bookingPath} variant="primary" size="sm">{t(lang, 'nav.book')}</Button>
      </li>
      <li>
        <a
          href={switchPath}
          class="text-warm-brown/60 hover:text-dark-brown transition-colors text-xs tracking-wider uppercase border-l border-cream-dark pl-4 ml-2"
        >
          {otherLang.toUpperCase()}
        </a>
      </li>
    </ul>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-dark-brown p-2"
      aria-label={lang === 'de' ? 'Menu öffnen' : 'Open menu'}
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream/95 backdrop-blur-sm border-t border-cream-dark">
    <ul class="flex flex-col items-center gap-6 py-8">
      {navItems.map((item) => (
        <>
          <li>
            <a
              href={item.href}
              data-scroll-href={item.scrollHref}
              class="nav-link text-warm-brown hover:text-dark-brown transition-colors text-sm tracking-wide uppercase"
              data-nav-item
              data-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
          {item.children && item.children.map((child) => (
            <li>
              <a
                href={child.href}
                class="text-warm-brown/70 hover:text-dark-brown transition-colors text-xs tracking-wide pl-4"
              >
                — {child.label}
              </a>
            </li>
          ))}
        </>
      ))}
      <li>
        <Button href={bookingPath} variant="primary" size="sm">{t(lang, 'nav.book')}</Button>
      </li>
      <li class="pt-2">
        <a
          href={switchPath}
          class="text-warm-brown/60 hover:text-dark-brown transition-colors text-xs tracking-wider uppercase"
        >
          {otherLang === 'en' ? 'English' : 'Deutsch'}
        </a>
      </li>
    </ul>
  </div>
</header>

<div class="h-20"></div>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // On homepage: use scroll hrefs instead of page links (but NOT for items with dropdowns that link to subpages)
  const isHomepage = window.location.pathname === '/' || window.location.pathname === '/en' || window.location.pathname === '/en/';
  if (isHomepage) {
    document.querySelectorAll('[data-scroll-href]').forEach((link) => {
      const scrollHref = link.getAttribute('data-scroll-href');
      if (scrollHref && scrollHref.length > 0) {
        link.setAttribute('href', scrollHref);
      }
    });

    // Active section highlighting - scroll-based on homepage
    const navSections = ['home', 'reiki', 'sound-and-soul', 'testimonials', 'ueber-mich'];
    const navLinks = document.querySelectorAll('[data-nav-item]');

    function setActiveNav(activeSectionId: string) {
      navLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-section');
        const isActive = linkSection === activeSectionId;
        link.classList.toggle('text-dark-brown', isActive);
        link.classList.toggle('font-semibold', isActive);
        if (isActive) {
          link.classList.remove('text-warm-brown');
        } else {
          link.classList.add('text-warm-brown');
        }
      });
    }

    function updateActiveSection() {
      const scrollY = window.scrollY + window.innerHeight * 0.3;
      let activeId = navSections[0];
      for (const id of navSections) {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= scrollY) {
          activeId = id;
        }
      }
      setActiveNav(activeId);
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActiveSection();
          ticking = false;
        });
        ticking = true;
      }
    });
    updateActiveSection();
  }
</script>

<style>
  [data-nav-item] {
    position: relative;
    transition: color 0.3s ease;
  }
  [data-nav-item]::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    right: 50%;
    height: 2px;
    background-color: var(--color-gold);
    transition: left 0.3s ease, right 0.3s ease;
  }
  [data-nav-item].font-semibold::after {
    left: 0;
    right: 0;
  }
</style>
