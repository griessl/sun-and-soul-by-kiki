---
import { t, getNavItems, getBookingPath, getLocalizedPath, type Lang } from '../../i18n/index';
import Button from '../ui/Button.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const navItems = getNavItems(lang);
const bookingPath = getBookingPath(lang);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const switchPath = getLocalizedPath(Astro.url.pathname, otherLang);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/90 backdrop-blur-sm">
  <nav class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
    <a href={lang === 'en' ? '/en' : '/'} class="font-heading text-dark-brown text-lg leading-tight">
      <span class="block text-xl font-semibold italic">Sun & Soul</span>
      <span class="block text-sm tracking-wider">by Kiki</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, '');
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link text-sm tracking-wide uppercase transition-colors',
                isActive ? 'text-dark-brown font-semibold' : 'text-warm-brown hover:text-dark-brown',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })}
      <li>
        <Button href={bookingPath} variant="primary" size="sm">{t(lang, 'nav.book')}</Button>
      </li>
      <li>
        <a
          href={switchPath}
          class="text-warm-brown/60 hover:text-dark-brown transition-colors text-xs tracking-wider uppercase border-l border-cream-dark pl-4 ml-2"
        >
          {otherLang.toUpperCase()}
        </a>
      </li>
    </ul>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-dark-brown p-2"
      aria-label={lang === 'de' ? 'Menu öffnen' : 'Open menu'}
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream/95 backdrop-blur-sm border-t border-cream-dark">
    <ul class="flex flex-col items-center gap-6 py-8">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-warm-brown hover:text-dark-brown transition-colors text-sm tracking-wide uppercase"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <Button href={bookingPath} variant="primary" size="sm">{t(lang, 'nav.book')}</Button>
      </li>
      <li class="pt-2">
        <a
          href={switchPath}
          class="text-warm-brown/60 hover:text-dark-brown transition-colors text-xs tracking-wider uppercase"
        >
          {otherLang === 'en' ? 'English' : 'Deutsch'}
        </a>
      </li>
    </ul>
  </div>
</header>

<div class="h-20"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Scroll indicator on homepage: highlight nav items based on visible section
  const isHomepage = window.location.pathname === '/' || window.location.pathname === '/en' || window.location.pathname === '/en/';
  if (isHomepage) {
    const navLinks = document.querySelectorAll('.nav-link');
    // Map section IDs to nav link hrefs
    const sectionToNav: Record<string, string> = {
      'home': '/',
      'mission': '/',
      'reiki': '/reiki',
      'preise': '/reiki',
      'sound-and-soul': '/',
      'testimonials': '/',
      'ueber-mich': '/ueber-mich',
    };
    // For EN
    const isEN = window.location.pathname.startsWith('/en');
    if (isEN) {
      sectionToNav['home'] = '/en/';
      sectionToNav['mission'] = '/en/';
      sectionToNav['reiki'] = '/en/reiki';
      sectionToNav['preise'] = '/en/reiki';
      sectionToNav['sound-and-soul'] = '/en/';
      sectionToNav['testimonials'] = '/en/';
      sectionToNav['ueber-mich'] = isEN ? '/en/about' : '/ueber-mich';
    }

    function setActiveNavLink(href: string) {
      navLinks.forEach((link) => {
        const linkHref = link.getAttribute('href')?.replace(/\/$/, '') || '/';
        const targetHref = href.replace(/\/$/, '') || '/';
        const isActive = linkHref === targetHref;
        link.classList.toggle('text-dark-brown', isActive);
        link.classList.toggle('font-semibold', isActive);
        if (isActive) link.classList.remove('text-warm-brown');
        else link.classList.add('text-warm-brown');
      });
    }

    function updateScrollIndicator() {
      const scrollY = window.scrollY + window.innerHeight * 0.3;
      const sections = document.querySelectorAll('section[id]');
      let activeHref = isEN ? '/en/' : '/';

      sections.forEach((section) => {
        const id = section.id;
        if (section instanceof HTMLElement && section.offsetTop <= scrollY && sectionToNav[id]) {
          activeHref = sectionToNav[id];
        }
      });
      setActiveNavLink(activeHref);
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateScrollIndicator(); ticking = false; });
        ticking = true;
      }
    });
    updateScrollIndicator();
  }
</script>

<style>
  .nav-link {
    position: relative;
  }
  .nav-link.font-semibold::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-gold);
  }
</style>
