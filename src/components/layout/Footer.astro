---
import { t, getNavItems, getBookingPath, type Lang } from '../../i18n/index';
import siteSettings from '../../content/settings/site.json';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const navItems = getNavItems(lang);
const bookingPath = getBookingPath(lang);
const footerLines = t(lang, 'footer.description').split('\n');
---

<footer class="bg-dark-brown text-cream-light py-16 mt-20">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <p class="font-heading text-2xl italic text-soft-white mb-2">Sun & Soul</p>
        <p class="text-sm tracking-wider mb-4">by Kiki</p>
        <p class="text-cream-dark text-sm leading-relaxed">
          {footerLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
        </p>
      </div>

      <div>
        <h3 class="font-heading text-lg text-soft-white mb-4">{t(lang, 'footer.pages')}</h3>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li><a href={item.href} class="text-cream-dark hover:text-soft-white transition-colors">{item.label}</a></li>
          ))}
          <li><a href={bookingPath} class="text-cream-dark hover:text-soft-white transition-colors">{t(lang, 'nav.book')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-lg text-soft-white mb-4">{t(lang, 'footer.contact')}</h3>
        <ul class="space-y-2 text-sm text-cream-dark">
          <li>
            <a href={`mailto:${siteSettings.email}`} class="hover:text-soft-white transition-colors">
              {siteSettings.email}
            </a>
          </li>
          <li>{siteSettings.location}, {lang === 'de' ? 'Deutschland' : 'Germany'}</li>
        </ul>
        <div class="mt-6">
          <a
            href={siteSettings.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-cream-dark hover:text-soft-white transition-colors text-sm"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            {siteSettings.instagram}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-warm-brown/30 text-center text-xs text-cream-dark space-y-2">
      <div class="flex justify-center gap-4">
        <a href={lang === 'en' ? '/en/legal' : '/impressum'} class="hover:text-soft-white transition-colors">{lang === 'en' ? 'Legal Notice' : 'Impressum'}</a>
        <span>&middot;</span>
        <a href={lang === 'en' ? '/en/privacy' : '/datenschutz'} class="hover:text-soft-white transition-colors">{lang === 'en' ? 'Privacy Policy' : 'Datenschutz'}</a>
      </div>
      <p>&copy; {new Date().getFullYear()} Sun & Soul by Kiki. {lang === 'en' ? 'All rights reserved.' : 'Alle Rechte vorbehalten.'}</p>
    </div>
  </div>
</footer>
