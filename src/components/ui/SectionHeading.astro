---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="text-center mb-12">
  <h2 class="font-heading text-4xl md:text-5xl text-dark-brown italic mb-4">{title}</h2>
  {subtitle && <p class="text-warm-brown text-lg max-w-2xl mx-auto">{subtitle}</p>}
</div>
