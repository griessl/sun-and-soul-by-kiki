---
interface Props {
  title: string;
  subtitle?: string;
  /** Heading-Level. Default h2. Auf Unterseiten als Haupttitel: h1 (SEO: genau eine h1/Seite). */
  as?: 'h1' | 'h2';
}

const { title, subtitle, as = 'h2' } = Astro.props;
const Heading = as;
---

<div class="text-center mb-12">
  <Heading class="font-heading text-4xl md:text-5xl text-dark-brown italic mb-4">{title}</Heading>
  {subtitle && <p class="text-warm-brown text-lg max-w-2xl mx-auto">{subtitle}</p>}
</div>
