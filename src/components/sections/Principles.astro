---
import SectionHeading from '../ui/SectionHeading.astro';
import { t, type Lang } from '../../i18n/index';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;

const principles = [
  'I let go of anger',
  'I let go of worry',
  "I'm filled with gratitude",
  "I'm dedicated and honest in my work",
  "I'm kind and compassionate to all living things including myself",
];
---

<section id="prinzipien" class="py-8 md:py-14 lg:py-20 px-4">
  <div class="mx-auto max-w-3xl text-center">
    <SectionHeading title={t(lang, 'principles.title')} />
    <p class="text-warm-brown text-lg italic mb-10">{t(lang, 'principles.intro')}</p>
    <ul class="space-y-4">
      {principles.map((p) => (
        <li class="text-warm-brown text-lg leading-relaxed">{p}</li>
      ))}
    </ul>
  </div>
</section>
