---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { t, getBookingPath, type Lang } from '../../i18n/index';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="reiki" class="py-8 md:py-14 lg:py-20 px-4 bg-cream-light/50">
  <div class="mx-auto max-w-4xl text-center">
    <SectionHeading title={t(lang, 'whatIsReiki.title')} />
    <p class="text-warm-brown leading-relaxed mb-6">{t(lang, 'whatIsReiki.intro')}</p>
    <p class="text-warm-brown leading-relaxed mb-6 italic">{t(lang, 'whatIsReiki.note')}</p>
    <p class="text-warm-brown leading-relaxed mb-10">{t(lang, 'whatIsReiki.body')}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button href={getBookingPath(lang)} variant="primary">{t(lang, 'whatIsReiki.bookBtn')}</Button>
      <Button href="#nach-der-session">{t(lang, 'whatIsReiki.sessionBtn')}</Button>
      <Button href="#vorteile">{t(lang, 'whatIsReiki.benefitsBtn')}</Button>
    </div>
  </div>
</section>
