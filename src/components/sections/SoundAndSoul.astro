---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { t, getBookingPath, type Lang } from '../../i18n/index';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="sound-and-soul" class="py-20 px-4">
  <div class="mx-auto max-w-4xl text-center">
    <SectionHeading title={t(lang, 'soundAndSoul.title')} subtitle={t(lang, 'soundAndSoul.subtitle')} />
    <p class="text-warm-brown leading-relaxed mb-6">{t(lang, 'soundAndSoul.p1')}</p>
    <p class="text-warm-brown leading-relaxed mb-10">{t(lang, 'soundAndSoul.p2')}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button href={getBookingPath(lang)}>{t(lang, 'soundAndSoul.bookBtn')}</Button>
    </div>
  </div>
</section>
