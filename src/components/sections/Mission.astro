---
import SectionHeading from '../ui/SectionHeading.astro';
import { t, type Lang } from '../../i18n/index';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="mission" class="py-20 px-4">
  <div class="mx-auto max-w-6xl">
    <SectionHeading title={t(lang, 'mission.title')} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="aspect-[3/4] bg-cream-dark rounded-full overflow-hidden mx-auto max-w-sm">
        <img src="/images/kiki-hero.jpg" alt="Kiki — Sun & Soul Reiki" class="w-full h-full object-cover object-top" loading="lazy" />
      </div>
      <div class="text-center md:text-left">
        <p class="text-warm-brown leading-relaxed mb-6">{t(lang, 'mission.p1')}</p>
        <p class="text-warm-brown leading-relaxed mb-6">{t(lang, 'mission.p2')}</p>
        <p class="text-warm-brown leading-relaxed">{t(lang, 'mission.p3')}</p>
      </div>
    </div>
  </div>
</section>
